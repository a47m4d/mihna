<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>مِهنة | منصة تقييم مهارات العمال</title>
<style>
:root{--bg:#f3f6fb;--card:#fff;--tx:#12263f;--mu:#5d6b7e;--pr:#0b3d6e;--prd:#082b4f;--gd:#f2b01e;--gdd:#c98a00;--bd:#dde5f0;--rd:#d93a3a;--am:#e08a00;--ok:#1a9a52;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box}html,body{margin:0}
body{background:var(--bg);color:var(--tx);font-family:"Segoe UI",Tahoma,Arial,sans-serif;line-height:1.7}
.hero{background:#fff;text-align:center;padding:18px 16px 0;border-bottom:5px solid var(--gd);box-shadow:0 4px 18px #0b3d6e14}
.hero img{width:min(230px,58vw);height:auto;display:block;margin:0 auto}
.hero p{margin:6px 0 14px;color:var(--pr);font-weight:700;font-size:1.02rem}
nav{display:flex;gap:6px;overflow-x:auto;padding:10px 12px;background:var(--prd);position:sticky;top:0;z-index:5}
nav button{flex:0 0 auto;border:1px solid #ffffff30;background:transparent;color:#dbe7f5;padding:8px 16px;border-radius:22px;font:inherit;cursor:pointer;transition:.2s}
nav button.on{background:var(--gd);color:var(--prd);border-color:var(--gd);font-weight:700}
main{max-width:860px;margin:0 auto;padding:16px 14px 30px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px}
.stat{background:var(--pr);color:#fff;border-radius:14px;padding:12px 8px;text-align:center;border-bottom:4px solid var(--gd)}
.stat b{display:block;font-size:1.7rem;color:var(--gd);line-height:1.2}.stat span{font-size:.85rem;opacity:.9}
.card{background:var(--card);border:1px solid var(--bd);border-right:5px solid var(--gd);border-radius:14px;padding:14px;margin-bottom:12px;box-shadow:0 2px 10px #0b3d6e0d}
h2{margin:0 0 10px;font-size:1.15rem;color:var(--pr)}
input,select{width:100%;padding:11px;border:1px solid var(--bd);border-radius:10px;background:#f8fafd;color:var(--tx);font:inherit;margin-bottom:8px}
input:focus,select:focus{outline:2px solid var(--gd);border-color:var(--gd)}
.btn{background:var(--pr);color:#fff;border:0;padding:10px 18px;border-radius:10px;font:inherit;cursor:pointer;font-weight:600}
.btn:hover{background:var(--prd)}
.btn.s{background:#fff;color:var(--pr);border:1px solid var(--pr)}.btn.d{background:var(--rd)}.btn.gold{background:var(--gd);color:var(--prd)}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center;justify-content:space-between}
.tag{display:inline-block;padding:2px 12px;border-radius:12px;font-size:.82rem;color:#fff}
.g{background:var(--ok)}.r{background:var(--rd)}.a{background:var(--am)}.n{background:#7a889b}
.bar{height:9px;background:#e6edf6;border-radius:6px;overflow:hidden;margin:6px 0 8px}.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--pr),var(--gd));border-radius:6px}
.alert{background:#fff6e0;color:#7a4b00;border:1px solid var(--gd);border-radius:12px;padding:10px 12px;margin-bottom:14px}
.q{margin-bottom:12px}.q label{display:block;padding:8px 10px;border:1px solid var(--bd);border-radius:10px;margin:5px 0;cursor:pointer;background:#f8fafd}
.muted{color:var(--mu);font-size:.9rem}
footer{text-align:center;color:var(--mu);font-size:.85rem;padding:0 0 20px}
#modal{position:fixed;inset:0;background:#06192ecc;display:none;align-items:center;justify-content:center;z-index:20;padding:16px}
#modal.show{display:flex}
.idc{background:#fff;color:#12263f;border-radius:18px;padding:16px;width:100%;max-width:340px;text-align:center;border-top:8px solid var(--pr);border-bottom:8px solid var(--gd)}
.idc img{width:130px;height:auto}#qr{display:flex;justify-content:center;margin:10px 0}
@media print{body *{visibility:hidden}#modal,#modal *{visibility:visible}.noprint{display:none}}
</style>
</head>
<body>
<div class="hero"><img id="lg" alt="مِهنة" src="data:image/jpeg;base64,"><p>مهارة موثّقة، عمل أفضل، مستقبل أكثر أمانًا</p></div>
<nav id="nav"></nav>
<main id="app"></main>
<footer>مِهنة © 2026 · منصة تقييم وتوثيق مهارات العمال</footer>
<div id="modal"><div><div class="idc" id="idc"></div><div class="row noprint" style="margin-top:10px;justify-content:center"><button class="btn" onclick="window.print()">طباعة</button><button class="btn s" onclick="closeM()">إغلاق</button></div></div></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
var TESTS={
safety:{n:"السلامة العامة",qs:[
{q:"ما أول إجراء قبل بدء العمل في موقع جديد؟",o:["البدء فوراً","فحص الموقع وتحديد المخاطر","تشغيل المعدات","لا شيء"],a:1},
{q:"متى يجب ارتداء خوذة الرأس؟",o:["في مواقع الإنشاء دائماً","عند المطر فقط","للمشرف فقط","اختياري"],a:0},
{q:"عند رؤية خطر غير آمن ماذا تفعل؟",o:["أتجاهله","أبلغ المسؤول وأوقف العمل","أصلحه بنفسي دون إبلاغ","أنتظر نهاية الدوام"],a:1}]},
construction:{n:"البناء",qs:[
{q:"ما نسبة خلط الإسمنت المعتادة للمونة؟",o:["1 إسمنت : 3 رمل","1 إسمنت : 10 رمل","لا نسبة","ماء فقط"],a:0},
{q:"أداة التأكد من استقامة الجدار عمودياً؟",o:["الميزان المائي والشاقول","المطرقة","المسطرة المعوجة","المنشار"],a:0},
{q:"لماذا يُرشّ الخرسانة بالماء بعد الصب؟",o:["للزينة","للمعالجة ومنع التشقق","لتخفيف اللون","لا فائدة"],a:1}]},
electrical:{n:"الكهرباء",qs:[
{q:"قبل العمل على أي دائرة كهربائية؟",o:["أفصل التيار وأعزلها","أعمل مباشرة","ألمس السلك للتجربة","أبلل اليد"],a:0},
{q:"لون سلك التأريض المعتمد غالباً؟",o:["أصفر/أخضر","أحمر","أزرق","أسود"],a:0},
{q:"وظيفة القاطع الكهربائي؟",o:["زينة","حماية الدائرة من زيادة الحمل","رفع الجهد","تخزين الكهرباء"],a:1}]},
welding:{n:"اللحام",qs:[
{q:"أهم معدة حماية للحام؟",o:["قناع اللحام والقفازات","قبعة قماش","نظارة شمس","لا شيء"],a:0},
{q:"ماذا تفعل قبل اللحام؟",o:["تنظيف السطح من الصدأ والدهان","اللحام فوق الدهان","رش ماء","لا شيء"],a:0},
{q:"مكان تخزين أسطوانات الغاز؟",o:["واقفة ومثبتة بعيداً عن الحرارة","مستلقية قرب النار","داخل سيارة مغلقة","أي مكان"],a:0}]}};
var TASKS=[{n:"بناء جدران وصب خرسانة",t:"construction",min:60},{n:"تمديدات كهربائية",t:"electrical",min:60},{n:"لحام هياكل معدنية",t:"welding",min:60},{n:"أعمال مساعدة عامة بالموقع",t:"safety",min:50}];
var TR={ar:["عربي","دورة قصيرة"],en:["English","Short course"],ur:["اردو","مختصر کورس"],hi:["हिन्दी","छोटा कोर्स"],bn:["বাংলা","সংক্ষিপ্ত কোর্স"]};
var S={w:[],tab:"workers"};
try{S.w=JSON.parse(localStorage.getItem("mihna")||"[]")}catch(e){}
function save(){try{localStorage.setItem("mihna",JSON.stringify(S.w))}catch(e){}}
function esc(s){return String(s).replace(/[&<>"']/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]})}
function avg(w){var k=Object.keys(w.scores);if(!k.length)return null;return Math.round(k.reduce(function(a,x){return a+w.scores[x]},0)/k.length)}
function lvl(p){return p===null?["لم يُختبر","n"]:p<50?["مبتدئ","r"]:p<80?["متوسط","a"]:["خبير","g"]}
function days(d){return Math.ceil((new Date(d)-new Date())/864e5)}
var TABS=[["workers","العمال"],["test","الاختبار"],["match","المطابقة"],["dev","التطوير والتدريب"],["certs","الشهادات والتنبيهات"]];
function nav(){document.getElementById("nav").innerHTML=TABS.map(function(t){return'<button class="'+(S.tab===t[0]?"on":"")+'" onclick="go(\''+t[0]+'\')">'+t[1]+'</button>'}).join("")}
function go(t){S.tab=t;render()}
function alerts(){var c=0;S.w.forEach(function(w){w.certs.forEach(function(x){if(days(x.exp)<=30)c++})});return c?'<div class="alert">⚠️ يوجد '+c+' شهادة/تدريب سلامة منتهي أو ينتهي خلال 30 يوماً. افتح تبويب «الشهادات والتنبيهات».</div>':""}
function opts(){return S.w.map(function(w){return'<option value="'+w.id+'">'+esc(w.name)+'</option>'}).join("")}
function render(){nav();var a=document.getElementById("app");a.innerHTML=alerts()+V[S.tab]()}
var V={
workers:function(){
var exp=S.w.filter(function(w){return avg(w)>=80}).length,cc=0;S.w.forEach(function(w){w.certs.forEach(function(x){if(days(x.exp)<=30)cc++})});var h='<div class="stats"><div class="stat"><b>'+S.w.length+'</b><span>عامل</span></div><div class="stat"><b>'+exp+'</b><span>خبير</span></div><div class="stat"><b>'+cc+'</b><span>تنبيهات</span></div></div><div class="card"><h2>إضافة عامل</h2><input id="nm" placeholder="اسم العامل"><select id="ln">'+Object.keys(TR).map(function(k){return'<option value="'+k+'">'+TR[k][0]+'</option>'}).join("")+'</select><div class="row"><button class="btn" onclick="addW()">إضافة</button><button class="btn gold" onclick="demo()">بيانات تجريبية</button></div></div>';
if(!S.w.length)return h+'<p class="muted">لا يوجد عمال بعد.</p>';
return h+S.w.map(function(w){var p=avg(w),l=lvl(p);return'<div class="card"><div class="row"><b>'+esc(w.name)+'</b><span class="tag '+l[1]+'">'+l[0]+(p!==null?" · "+p+"%":"")+'</span></div><div class="bar"><i style="width:'+(p||0)+'%"></i></div><div class="muted">لغة العامل: '+TR[w.lang][0]+'</div><div class="row" style="margin-top:8px"><button class="btn" onclick="card('+w.id+')">بطاقة المهارات QR</button><button class="btn d" onclick="delW('+w.id+')">حذف</button></div></div>'}).join("")},
test:function(){
if(!S.w.length)return'<p class="muted">أضف عاملاً أولاً.</p>';
return'<div class="card"><h2>اختبار عملي قصير</h2><select id="tw">'+opts()+'</select><select id="tt">'+Object.keys(TESTS).map(function(k){return'<option value="'+k+'">'+TESTS[k].n+'</option>'}).join("")+'</select><button class="btn" onclick="startT()">ابدأ الاختبار</button></div><div id="tq"></div>'},
match:function(){
if(!S.w.length)return'<p class="muted">أضف عمالاً أولاً.</p>';
return TASKS.map(function(t){var r=S.w.map(function(w){return{w:w,s:w.scores[t.t],sf:w.scores.safety}}).sort(function(a,b){return(b.s||-1)-(a.s||-1)});
return'<div class="card"><h2>'+t.n+'</h2><div class="muted">الحد الأدنى: '+t.min+'%'+(t.t!=="safety"?" + اجتياز السلامة 60%":"")+'</div>'+r.map(function(x){var ok=x.s!==undefined&&x.s>=t.min&&(t.t==="safety"||(x.sf!==undefined&&x.sf>=60));var st=x.s===undefined?["لم يُختبر","n"]:ok?["مناسب","g"]:["يحتاج تطوير","r"];return'<div class="row"><span>'+esc(x.w.name)+(x.s!==undefined?" ("+x.s+"%)":"")+'</span><span class="tag '+st[1]+'">'+st[0]+'</span></div>'}).join("")+'</div>'}).join("")},
dev:function(){
if(!S.w.length)return'<p class="muted">أضف عمالاً أولاً.</p>';
return S.w.map(function(w){var weak=Object.keys(w.scores).filter(function(k){return w.scores[k]<60});
return'<div class="card"><h2>'+esc(w.name)+'</h2>'+(weak.length?weak.map(function(k){return'<div>📘 '+TR[w.lang][1]+' — '+TESTS[k].n+' <span class="muted">(بلغة: '+TR[w.lang][0]+')</span></div>'}).join(""):'<span class="muted">لا توجد مهارات تحتاج تطويراً حالياً (أو لم يُختبر بعد).</span>')+'</div>'}).join("")},
certs:function(){
if(!S.w.length)return'<p class="muted">أضف عمالاً أولاً.</p>';
var h='<div class="card"><h2>إضافة شهادة / تدريب</h2><select id="cw">'+opts()+'</select><input id="cn" placeholder="اسم الشهادة (مثال: سلامة المواقع)"><input id="ce" type="date"><button class="btn" onclick="addC()">حفظ</button></div>';
return h+S.w.map(function(w){return w.certs.length?'<div class="card"><h2>'+esc(w.name)+'</h2>'+w.certs.map(function(x,i){var d=days(x.exp),st=d<0?["منتهية","r"]:d<=30?["تنتهي خلال "+d+" يوم","a"]:["سارية","g"];return'<div class="row"><span>'+esc(x.n)+' · '+x.exp+'</span><span class="tag '+st[1]+'">'+st[0]+'</span></div>'}).join("")+'</div>':""}).join("")}};
function addW(){var n=document.getElementById("nm").value.trim();if(!n)return;S.w.push({id:Date.now(),name:n,lang:document.getElementById("ln").value,scores:{},certs:[]});save();render()}
function delW(id){S.w=S.w.filter(function(w){return w.id!==id});save();render()}
function demo(){var d=function(n){return new Date(Date.now()+n*864e5).toISOString().slice(0,10)};
S.w.push({id:1,name:"محمد خان",lang:"ur",scores:{safety:80,construction:90},certs:[{n:"سلامة المواقع",exp:d(15)}]},{id:2,name:"راجو كومار",lang:"hi",scores:{safety:70,electrical:45},certs:[{n:"كهرباء منخفضة الجهد",exp:d(200)}]},{id:3,name:"رحمن علي",lang:"bn",scores:{safety:55,welding:85},certs:[{n:"لحام",exp:d(-5)}]});save();render()}
function addC(){var w=S.w.find(function(x){return x.id==document.getElementById("cw").value}),n=document.getElementById("cn").value.trim(),e=document.getElementById("ce").value;if(!w||!n||!e)return;w.certs.push({n:n,exp:e});save();render()}
function startT(){var w=document.getElementById("tw").value,t=document.getElementById("tt").value;
document.getElementById("tq").innerHTML='<div class="card">'+TESTS[t].qs.map(function(q,i){return'<div class="q"><b>'+(i+1)+'. '+q.q+'</b>'+q.o.map(function(o,j){return'<label><input type="radio" name="q'+i+'" value="'+j+'" style="width:auto;margin:0 0 0 8px">'+o+'</label>'}).join("")+'</div>'}).join("")+'<button class="btn" onclick="sub('+w+',\''+t+'\')">إنهاء وحفظ النتيجة</button></div>'}
function sub(id,t){var c=0,qs=TESTS[t].qs;qs.forEach(function(q,i){var r=document.querySelector('input[name=q'+i+']:checked');if(r&&+r.value===q.a)c++});var p=Math.round(c/qs.length*100),w=S.w.find(function(x){return x.id===id});w.scores[t]=p;save();alert("النتيجة: "+p+"%");go("workers")}
function card(id){var w=S.w.find(function(x){return x.id===id}),p=avg(w),l=lvl(p);
var sk=Object.keys(w.scores).map(function(k){return TESTS[k].n+" "+w.scores[k]+"%"}).join(" | ")||"-";
var txt="MIHNA|ID:"+w.id+"|"+w.name+"|Level:"+l[0]+"|Score:"+(p===null?"-":p)+"%|"+sk+"|"+new Date().toISOString().slice(0,10);
document.getElementById("idc").innerHTML='<img src="'+document.getElementById("lg").src+'" alt=""><div style="font-size:.85rem;color:#5d6b7e">بطاقة المهارات الرقمية</div><h2 style="color:#0b3d6e;margin:6px 0 0">'+esc(w.name)+'</h2><div>المستوى: <b>'+l[0]+'</b>'+(p!==null?' ('+p+'%)':'')+'</div><div id="qr"></div><div style="font-size:.8rem;color:#555">'+esc(sk)+'</div>';
document.getElementById("modal").classList.add("show");
try{new QRCode(document.getElementById("qr"),{text:txt,width:180,height:180})}catch(e){document.getElementById("qr").textContent="تعذر توليد QR"}}
function closeM(){document.getElementById("modal").classList.remove("show")}
render();
</script>
</body>
</html>
